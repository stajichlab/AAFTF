# =============================================================================
# AAFTF - Automatic Assembly For The Fungi
# Docker image built with conda-managed dependencies.
#
# Build (from source, editable install). AAFTF_VERSION must be supplied
# explicitly (the .git directory is excluded from the build context by
# .dockerignore, so hatch-vcs cannot derive the version inside the image). The
# --build-arg (a tag like v0.7.0 or `git describe` output, converted to PEP 440 in
# step 4) is given to hatch-vcs as SETUPTOOLS_SCM_PRETEND_VERSION and ends up in
# the installed package metadata, which `AAFTF --version` reads:
#   docker build --build-arg AAFTF_VERSION=$(git describe --tags --always) \
#       -t aaftf:latest .
#
# Build for a specific tagged release (installs the published PyPI package):
#   docker build --build-arg AAFTF_VERSION=0.7.0 --build-arg INSTALL_MODE=pypi \
#       -t aaftf:v0.7.0 .
#
# Run:
#   docker run --rm aaftf:latest AAFTF --help
#
# Run with data and external DB:
#   docker run --rm \
#     -v /path/to/data:/data \
#     -v /path/to/aaftf_db:/opt/aaftf_db \
#     aaftf:latest AAFTF trim --read1 /data/R1.fq.gz --read2 /data/R2.fq.gz
# =============================================================================

FROM debian:bookworm-slim

ARG AAFTF_VERSION=0.0.0+unknown

ARG INSTALL_MODE=source
ENV AAFTF_INSTALL_MODE=${INSTALL_MODE}

LABEL org.opencontainers.image.title="AAFTF"
LABEL org.opencontainers.image.description="Automatic Assembly For The Fungi"
LABEL org.opencontainers.image.url="https://github.com/stajichlab/AAFTF"
LABEL org.opencontainers.image.source="https://github.com/stajichlab/AAFTF"
LABEL org.opencontainers.image.licenses="MIT"

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# ---------------------------------------------------------------------------
# 1. System dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        bzip2 \
        perl \
        libgomp1 \
        procps \
        git \
        tar \
        pigz \
        aria2 \
        rsync \
        locales \
        locales-all \
        && \
    rm -rf /var/lib/apt/lists/*

# Set locale for bioinformatics tools that require it (avoids
# "bash: warning: setlocale: LC_ALL: cannot change locale" when the host
# exports LC_ALL=en_US.UTF-8 but no en_US locale is generated in the image).
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    LANGUAGE=en_US:en

# ---------------------------------------------------------------------------
# 2. Install Miniconda
# ---------------------------------------------------------------------------
ENV MINICONDA_VERSION=23.11.0-0
ENV CONDA_PREFIX=/opt/conda
ENV PATH="${CONDA_PREFIX}/bin:${PATH}"

RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-${MINICONDA_VERSION}-Linux-x86_64.sh && \
    /bin/bash Miniconda3-${MINICONDA_VERSION}-Linux-x86_64.sh -b -p "${CONDA_PREFIX}" && \
    rm Miniconda3-${MINICONDA_VERSION}-Linux-x86_64.sh

# ---------------------------------------------------------------------------
# 3. Configure conda + install the tools into the base environment
#    (${CONDA_PREFIX} is the Miniconda base, so install into it rather than
#    `conda create` over it; version specs are quoted so bash does not treat
#    ">" as a redirect)
# ---------------------------------------------------------------------------
RUN conda config --add channels conda-forge && \
    conda config --add channels bioconda && \
    conda config --set channel_priority strict && \
    conda install -y -n base \
        "python>=3.10,<3.15" \
        "samtools>=1.24" \
        biopython \
        bwa \
        minimap2 \
        freebayes \
        yak \
        polypolish \
        nextpolish2 \
        blast \
        diamond \
        sourmash \
        bowtie2 \
        trimmomatic \
        spades \
        fastp \
        flye \
        racon \
        fastqc \
        hifiasm \
        kraken2 \
        novoplasty \
        ncbi-fcs-gx \
        mosdepth \
        matplotlib \
        "bbmap>=39.80" \
        "pypolca>=0.5.0" \
        "pytest>=7.0" \
        pip \
        && \
    conda clean -afy

# ---------------------------------------------------------------------------
# 4. Install AAFTF
# ---------------------------------------------------------------------------
WORKDIR /opt/AAFTF

COPY pyproject.toml ./
COPY README.md ./
COPY aaftf/ aaftf/

# hatch-vcs only honours the generic SETUPTOOLS_SCM_PRETEND_VERSION and needs a
# PEP 440 version: drop a leading "v" and turn "-g<hash>" into "+g<hash>".
RUN ver="${AAFTF_VERSION#v}" && \
    export SETUPTOOLS_SCM_PRETEND_VERSION="${ver/-g/+g}" && \
    if [ "${AAFTF_INSTALL_MODE}" = "pypi" ]; then \
        pip install "aaftf==${SETUPTOOLS_SCM_PRETEND_VERSION}"; \
    else \
        pip install --no-deps -e .; \
    fi && \
    python -c "import sys; from packaging.version import Version; from aaftf import __version__ as v; sys.exit(0 if Version(v) == Version(sys.argv[1]) else f'AAFTF reports {v}, expected {sys.argv[1]}')" "${SETUPTOOLS_SCM_PRETEND_VERSION}"

# ---------------------------------------------------------------------------
# 5. Smoke test
# ---------------------------------------------------------------------------
RUN AAFTF --version

# ---------------------------------------------------------------------------
# 6. Cleanup build artefacts
# ---------------------------------------------------------------------------
RUN rm -rf /root/.cache && \
    conda clean -afy

# ---------------------------------------------------------------------------
# 7. Runtime environment
# ---------------------------------------------------------------------------
ENV AAFTF_DB="/opt/aaftf_db"

WORKDIR /data
CMD ["AAFTF", "--help"]
