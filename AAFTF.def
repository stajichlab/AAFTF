Bootstrap: docker
From: debian:bookworm-slim

# =============================================================================
# AAFTF - Automatic Assembly For The Fungi
# Singularity/Apptainer definition file
#
# Build (defaults: git_ref=main, skip_db_download=0):
#   singularity build AAFTF.sif AAFTF.def
#
# Build a specific tagged release without baking in the sourmash DB
# (used by CI for archived release .sif builds):
#   singularity build --build-arg git_ref=v0.7.0 \
#       --build-arg skip_db_download=1 AAFTF.sif AAFTF.def
#
# Run:
#   singularity exec AAFTF.sif AAFTF --help
#   singularity run --bind /path/to/data:/data AAFTF.sif
# =============================================================================

%arguments
    git_ref=main
    skip_db_download=0

%labels
    Author Jason Stajich <jasonstajich.phd@gmail.com>
    Description AAFTF: Automatic Assembly For The Fungi
    Version {{ git_ref }}
    URL https://github.com/stajichlab/AAFTF

%help
    AAFTF (Automatic Assembly For The Fungi) provides a unified workflow for
    fungal genome assembly, cleanup, mitochondrial assembly, and polishing.

    Usage:
        singularity exec AAFTF.sif AAFTF --help
        singularity exec --bind /path/to/data:/data AAFTF.sif AAFTF trim --left R1.fq.gz --right R2.fq.gz

    The database directory is at /opt/aaftf_db (set AAFTF_DB to override).

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    . /opt/aaftf_activate.sh
    export AAFTF_DB="/opt/aaftf_db"

%setup
    # Runs on the HOST before %post; nothing needed here.
    true

%post -c /bin/bash
    set -e

    # -------------------------------------------------------------------------
    # 1. System dependencies
    # -------------------------------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        bzip2 \
        perl \
        libgomp1 \
        procps \
        git \
        tar \
	pigz \
	aria2 \
	rsync \
	locales \
	locales-all
    rm -rf /var/lib/apt/lists/*

    # -------------------------------------------------------------------------
    # 2. Install pixi
    # -------------------------------------------------------------------------
    export PIXI_HOME=/opt/pixi
    curl -fsSL https://pixi.sh/install.sh | bash
    export PATH="${PIXI_HOME}/bin:/opt/build/AAFTF/.pixi/envs/default/bin:${PATH}"

    # -------------------------------------------------------------------------
    # 3. Clone AAFTF repository from GitHub at the requested ref (branch or tag)
    # -------------------------------------------------------------------------
    git clone --branch "{{ git_ref }}" --depth 1 https://github.com/stajichlab/AAFTF.git /opt/build/AAFTF
    export AAFTF_DB=/opt/aaftf_db

    # -------------------------------------------------------------------------
    # 4. Resolve & install conda + PyPI dependencies via pixi
    # -------------------------------------------------------------------------
    cd /opt/build/AAFTF
    pixi install --locked --frozen
    pixi shell-hook --shell bash | grep '^export ' > /opt/aaftf_activate.sh
    chmod +x /opt/aaftf_activate.sh
    pixi clean cache --yes
    # -------------------------------------------------------------------------
    # 5. Apply polca.sh patch
    #    Replace MaSuRCAs bundled polca.sh with the version from patches/
    #    that is compatible with newer samtools (-o flag removed from sort).
    # -------------------------------------------------------------------------
    POLCA_INSTALLED=$(find .pixi/envs/default -name "polca.sh" | head -1)
    if [ -n "$POLCA_INSTALLED" ]; then
        echo "Replacing $POLCA_INSTALLED with patched version"
        cp patches/polca.sh "$POLCA_INSTALLED"
        chmod +x "$POLCA_INSTALLED"
    else
        echo "WARNING: polca.sh not found in installed environment"
    fi

    # -------------------------------------------------------------------------
    # 6. Database download (skippable via --build-arg skip_db_download=1,
    #    used by CI where disk/time budgets don't allow baking in the DB;
    #    users then bind-mount or download AAFTF_DB separately at run time)
    # -------------------------------------------------------------------------
    mkdir -p $AAFTF_DB
    . /opt/aaftf_activate.sh

    if [ "{{ skip_db_download }}" = "1" ]; then
        echo "Skipping database download (skip_db_download=1)"
    else
        AAFTF download --AAFTF_DB $AAFTF_DB --sourdb-type gbk
    fi

    # -------------------------------------------------------------------------
    # 7. Make AAFTF available in LOGIN shells too.
    #    The %environment block above only takes effect for non-login container
    #    shells (singularity run/exec). SLURM/Nextflow run task scripts via
    #    /bin/bash -l, and a login shell re-sources /etc/profile, which
    #    unconditionally resets PATH -- dropping the pixi env dir that
    #    %environment exported. /etc/profile sources every /etc/profile.d/*.sh,
    #    so bake the activation there so AAFTF survives a login shell.
    # -------------------------------------------------------------------------
    cat > /etc/profile.d/aaaftf.sh <<'EOF'
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
if [ -r /opt/aaftf_activate.sh ]; then
    . /opt/aaftf_activate.sh
fi
export AAFTF_DB="/opt/aaftf_db"
EOF
    chmod +x /etc/profile.d/aaaftf.sh

    # -------------------------------------------------------------------------
    # 8. Cleanup build artefacts to reduce image size
    # -------------------------------------------------------------------------
    AAFTF --version || true
    rm -rf /opt/pixi
    rm -rf /root/.cache

    # Verify the install
    AAFTF --version || true
    echo $PATH
%runscript
    exec AAFTF "$@"

%test
    # Basic smoke test: print version (non-login, via %environment)
    AAFTF --version

    # Login-shell smoke test: Nextflow/SLURM run tasks through /bin/bash -l,
    # and a login shell re-sources /etc/profile which resets PATH -- the
    # /etc/profile.d/aaaftf.sh baked in %post must restore AAFTF.
    bash -lc 'AAFTF --version'
