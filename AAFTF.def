Bootstrap: docker
From: debian:bookworm-slim

# =============================================================================
# AAFTF - Automatic Assembly For The Fungi
# Singularity/Apptainer definition file
#
# Build (defaults: git_ref=main, skip_db_download=1 -- databases are NOT baked in;
# bind-mount an AAFTF_DB folder at run time instead):
#   singularity build AAFTF.sif AAFTF.def
#
# Build a specific tagged release with the databases baked into the image:
#   singularity build --build-arg git_ref=v0.7.0 \
#       --build-arg skip_db_download=0 AAFTF.sif AAFTF.def
#
# Run:
#   singularity exec AAFTF.sif AAFTF --help
#   singularity run --bind /path/to/data:/data AAFTF.sif
# =============================================================================

%arguments
    git_ref=main
    skip_db_download=1

%labels
    Author Jason Stajich <jasonstajich.phd@gmail.com>
    Description AAFTF: Automatic Assembly For The Fungi
    Version {{ git_ref }}
    URL https://github.com/stajichlab/AAFTF

%help
    AAFTF (Automatic Assembly For The Fungi) provides a unified workflow for
    fungal genome assembly, cleanup, mitochondrial assembly, and polishing.

    Usage:
        singularity exec AAFTF.sif AAFTF --help
        singularity exec --bind /path/to/data:/data AAFTF.sif AAFTF trim --read1 R1.fq.gz --read2 R2.fq.gz

    The database directory is at /opt/aaftf_db (set AAFTF_DB to override).

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    . /opt/aaftf_activate.sh
    export AAFTF_DB="/opt/aaftf_db"

%setup
    # Runs on the HOST before %post; nothing needed here.
    true

%post -c /bin/bash
    set -e

    # -------------------------------------------------------------------------
    # 1. System dependencies
    # -------------------------------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        bzip2 \
        perl \
        libgomp1 \
        procps \
        git \
        tar \
	pigz \
	aria2 \
	rsync \
	locales \
	locales-all \
	build-essential \
	cmake \
	libbz2-dev \
	binutils \
	patch \
	python3 \
	zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    # -------------------------------------------------------------------------
    # 2. Install pixi
    # -------------------------------------------------------------------------
    export PIXI_HOME=/opt/pixi
    curl -fsSL https://pixi.sh/install.sh | bash
    export PATH="${PIXI_HOME}/bin:/opt/build/AAFTF/.pixi/envs/complete/bin:${PATH}"

    # -------------------------------------------------------------------------
    # 3. Clone AAFTF repository from GitHub at the requested ref (branch or tag)
    # -------------------------------------------------------------------------
    git clone --branch "{{ git_ref }}" --depth 1 https://github.com/stajichlab/AAFTF.git /opt/build/AAFTF
    export AAFTF_DB=/opt/aaftf_db

    # -------------------------------------------------------------------------
    # 4. Resolve & install conda + PyPI dependencies via pixi
    # -------------------------------------------------------------------------
    cd /opt/build/AAFTF
    # "complete" = default-pipeline tools + every optional tool (see [tool.pixi.environments])
    pixi install --environment complete --locked --frozen
    pixi shell-hook --environment complete --shell bash | grep '^export ' > /opt/aaftf_activate.sh
    chmod +x /opt/aaftf_activate.sh
    # patched POLCA scripts are installed into bin/ with AAFTF (pyproject.toml shared-scripts)
    test -x .pixi/envs/complete/bin/aaftf_polca.sh
    test -x .pixi/envs/complete/bin/fix_consensus_from_vcf.pl
    pixi clean cache --yes
    # -------------------------------------------------------------------------
    # 5. Build bowtie2 from source
    #    The conda bowtie2 falls back from AVX2 (x86-64-v3) at runtime; the
    #    source build in install_scripts/pixi_install_bowtie2.sh shadows it.
    #    Call the script directly (mirroring the funannotate Dockerfile) rather
    #    than `pixi run install-bowtie2`, which re-resolves PyPI deps and can
    #    fail with a pixi interpreter-query error. The script reads
    #    $CONDA_PREFIX from the environment (exported by aaftf_activate.sh).
    # -------------------------------------------------------------------------
    . /opt/aaftf_activate.sh
    bash install_scripts/pixi_install_bowtie2.sh
    test -x "$CONDA_PREFIX/bin/bowtie2"
    test -x "$CONDA_PREFIX/bin/bowtie2-align-s-v256"

    # -------------------------------------------------------------------------
    # 6. Build SPAdes for x86-64-v2 AND x86-64-v3 with runtime dispatch
    #     (bioconda SPAdes forces -march=x86-64-v3 and dies with SIGILL on
    #     older CPUs). See install_scripts/install_spades_multiarch.sh.
    #     Force a build at run time with SPADES_ARCH=v2|v3.
    # -------------------------------------------------------------------------
    bash install_scripts/install_spades_multiarch.sh
    test -x /opt/spades/v2/bin/spades-hammer
    test -x /opt/spades/v3/bin/spades-hammer

    # -------------------------------------------------------------------------
    # 7. Rebuild MEGAHIT from source without the bioconda -march=x86-64-v3
    #     flag so its own BMI2/POPCNT/baseline core dispatch works on older
    #     CPUs. See install_scripts/install_megahit_from_source.sh.
    # -------------------------------------------------------------------------
    bash install_scripts/install_megahit_from_source.sh
    test -f "$CONDA_PREFIX/bin/.megahit_sourcebuild_1.2.9"

    # -------------------------------------------------------------------------
    # 8. Database download (skippable via --build-arg skip_db_download=1,
    #    used by CI where disk/time budgets don't allow baking in the DB;
    #    users then bind-mount or download AAFTF_DB separately at run time)
    # -------------------------------------------------------------------------
    mkdir -p $AAFTF_DB
    . /opt/aaftf_activate.sh

    if [ "{{ skip_db_download }}" = "1" ]; then
        echo "Skipping database download (skip_db_download=1)"
    else
        AAFTF database phix univec euks proks mitodb taxpurge fcs_script fcs_image
    fi

    # -------------------------------------------------------------------------
    # 9. Make AAFTF available in LOGIN shells too.
    #    The %environment block above only takes effect for non-login container
    #    shells (singularity run/exec). SLURM/Nextflow run task scripts via
    #    /bin/bash -l, and a login shell re-sources /etc/profile, which
    #    unconditionally resets PATH -- dropping the pixi env dir that
    #    %environment exported. /etc/profile sources every /etc/profile.d/*.sh,
    #    so bake the activation there so AAFTF survives a login shell.
    # -------------------------------------------------------------------------
    cat > /etc/profile.d/aaftf.sh <<'EOF'
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
if [ -r /opt/aaftf_activate.sh ]; then
    . /opt/aaftf_activate.sh
fi
export AAFTF_DB="/opt/aaftf_db"
EOF
    chmod +x /etc/profile.d/aaftf.sh

    # -------------------------------------------------------------------------
    # 10. Cleanup build artefacts to reduce image size
    # -------------------------------------------------------------------------
    AAFTF --version || true
    rm -rf /opt/pixi
    rm -rf /root/.cache

    # Verify the install
    AAFTF --version || true
    echo $PATH
%runscript
    exec AAFTF "$@"

%test
    # Basic smoke test: print version (non-login, via %environment)
    AAFTF --version

    # Login-shell smoke test: Nextflow/SLURM run tasks through /bin/bash -l,
    # and a login shell re-sources /etc/profile which resets PATH -- the
    # /etc/profile.d/aaftf.sh baked in %post must restore AAFTF.
    bash -lc 'AAFTF --version'
