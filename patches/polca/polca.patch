+# Resolve a tool: honour a preset variable, then PATH (which includes $MYPATH). Uses `command -v`
+# rather than `which`, which can be an exported shell function with incompatible options.
+function find_tool {
+  local preset="$1" name="$2"
+  if [[ -n "$preset" ]];then echo "$preset"; else command -v "$name"; fi
+}
